QWidget { background: #101419; color: #e6ecef; font-family: "Segoe UI"; font-size: 13px; }
QMainWindow { background: #101419; }
QFrame#sidebar { background: #0c1014; border-right: 1px solid #242c33; }
QFrame#sidebar QLabel { background: transparent; }
QLabel#brand { font-size: 25px; font-weight: 700; color: #70dfc1; }
QLabel#eyebrow { color: #70dfc1; font-size: 11px; font-weight: 600; }
QLabel#heading { font-size: 28px; font-weight: 600; }
QLabel#muted { color: #91a0ac; }
QLabel#section { font-size: 15px; font-weight: 600; }
QLabel#badge { background: #16352e; color: #81e5c7; border-radius: 12px; padding: 6px 12px; }
QFrame#card { background: #171d24; border: 1px solid #29323b; border-radius: 12px; }
QFrame#card QLabel, QFrame#card QWidget#transparent { background: transparent; }
QFrame#dropZone { background: #12251f; border: 1px dashed #4d8d7c; border-radius: 10px; }
QFrame#dropZone:hover { background: #19332a; border-color: #7ce9c9; }
QFrame#dropZone QLabel { border: none; background: transparent; }
QLabel#dropTitle { font-size: 17px; font-weight: 600; }
QPushButton { background: #242e38; border: 1px solid #36434f; border-radius: 7px; padding: 9px 14px; font-weight: 600; }
QPushButton:hover { background: #2d3b48; border-color: #698377; }
QPushButton:pressed { background: #354a4b; }
QPushButton:disabled { color: #66737e; background: #1b232b; border-color: #29323b; }
QPushButton#primary { background: #79e2c1; color: #10251e; border: none; padding: 12px 20px; }
QPushButton#primary:hover { background: #a0f0d7; }
QPushButton#primary:disabled { background: #2b5145; color: #83a899; }
QPushButton#nav { background: #1a302a; color: #8ee5c9; border: none; text-align: left; }
QPushButton#subtle { background: transparent; border: none; color: #9cacb7; text-align: left; padding-left: 0; }
QLineEdit, QComboBox, QSpinBox { background: #10161c; border: 1px solid #34414d; border-radius: 6px; padding: 8px; selection-background-color: #2f7560; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #79e2c1; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url("@ASSETS@/chevron.svg"); width: 12px; height: 8px; }
QComboBox QAbstractItemView { background: #1c2630; selection-background-color: #2b5145; }
QListWidget { background: #10161c; border: 1px solid #29333c; border-radius: 7px; padding: 5px; }
QListWidget::item { padding: 10px; border-radius: 5px; }
QListWidget::item:selected { background: #244a3e; color: #a8f4d9; }
QListWidget::item:hover { background: #20322f; }
QPlainTextEdit { background: #0c1117; border: 1px solid #303b46; border-radius: 7px; font-family: Consolas; font-size: 11px; }
QProgressBar { border: none; background: #29353d; border-radius: 3px; min-height: 5px; max-height: 5px; }
QProgressBar::chunk { background: #79e2c1; border-radius: 3px; }
QSlider::groove:horizontal { background: #2d3c46; height: 5px; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #79e2c1; border-radius: 2px; }
QSlider::handle:horizontal { background: #a0f0d7; width: 12px; margin: -4px 0; border-radius: 6px; }
QToolTip { background: #26333d; color: #e7f3ee; border: 1px solid #5b7a6c; padding: 5px; }
